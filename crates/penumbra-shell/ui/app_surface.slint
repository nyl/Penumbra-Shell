import { Theme } from "theme.slint";
import { AppItem, TaskItem, HomescreenItem } from "app_item.slint";
import { BottomDock } from "dock.slint";
import { ShortcutTile } from "shortcut_tile.slint";
import { AppDrawer } from "app_drawer.slint";
import { WallpaperItem, FileEntry, FolderItem, HomescreenContextMenu, WallpaperPicker } from "wallpaper_picker.slint";
import { RecentsSwitcher, AppCardData } from "recents_switcher.slint";

export { AppItem, TaskItem, HomescreenItem, WallpaperItem, FileEntry, FolderItem, RecentsSwitcher, AppCardData }

export component AppSurface inherits Rectangle {
    in-out property <int> active-mode: 0; // 0: Home, 1: Recents Overview, 2: App Drawer, 3: Active App
    in-out property <string> active-app: "terminal";
    in property <string> time-text: "17:30";
    in property <string> date-text: "Sunday, Oct 19";
    in property <[AppItem]> installed-apps: [];
    in property <[AppItem]> dock-apps: [];
    in property <[HomescreenItem]> homescreen-items: [];
    in-out property <int> current-page: 0;
    in-out property <int> num-pages: 1;
    in-out property <bool> is-editing: false;
    in property <bool> reject-dock-drop: false;

    // Drag-and-drop state
    in-out property <bool> is-dragging-app: false;
    in-out property <bool> dragging-is-folder: false;
    in-out property <AppItem> dragging-app-item;
    in-out property <length> drag-x: 0px;
    in-out property <length> drag-y: 0px;

    // Folder view modal state
    in-out property <bool> is-folder-open: false;
    in-out property <string> open-folder-id: "";
    in-out property <string> open-folder-name: "Folder";
    in-out property <[AppItem]> open-folder-apps: [];
    in-out property <string> dragging-from-folder-id: "";
    in-out property <int> dragging-from-folder-idx: -1;
    property <int> folder-drag-target-idx: (!root.is-dragging-app || !root.is-folder-open) ? -1 :
        Math.clamp(
            Math.clamp(Math.floor(((root.drag-y / 1px) - 252.0) / 100.0), 0, Math.max(0, (root.open-folder-apps.length - 1) / 3)) * 3 +
            Math.clamp(Math.floor(((root.drag-x / 1px) - 60.0) / 90.0), 0, 2),
            0, Math.max(0, root.open-folder-apps.length - 1)
        );

    // Edge Dwell Timer state for creating/turning pages while dragging
    property <int> dwell-direction: 0; // 1: right, -1: left, 0: none
    property <int> dwell-ticks: 0;

    // Overview running tasks and carousel index
    in property <[AppCardData]> running-tasks: [];
    in-out property <int> overview-index: 0;
    in-out property <float> overview-scroll: 0.0;
    in-out property <bool> is-dragging-carousel: false;
    property <int> safe-overview-index: Math.max(0, Math.min(Math.round(root.overview-scroll), Math.max(0, root.running-tasks.length - 1)));

    animate overview-scroll {
        duration: is-dragging-carousel ? 0ms : 260ms;
        easing: cubic-bezier(0.2, 0.9, 0.3, 1.0);
    }

    callback app-clicked(string);
    callback app-removed-from-dock(string);
    callback app-removed-from-homescreen(string);
    callback app-pinned-to-dock(string);
    callback app-pinned-to-homescreen(string);
    callback app-dropped-on-homescreen(string, int, length, length); // id, page, sx, sy
    callback folder-renamed(string, string); // folder_id, new_name
    callback folder-item-removed(string, string); // folder_id, app_id
    callback folder-apps-reordered(string, int, int); // folder_id, from_idx, to_idx
    callback open-folder-requested(string); // folder_id
    callback clear-all-recents();
    callback resume-active-task();
    callback select-task(int);
    callback close-task(int);
    callback overview-index-changed(int);
    callback overview-scroll-changed(float, bool);
    callback overview-drag-released(float, float);
    callback active-card-dy-changed(float);
    callback exit-overview();
    callback execute-command(string) -> string;
    callback list-directory(string) -> string;
    callback eval-calc(string, string, string) -> string;
    callback save-file(string, string) -> bool;
    callback homescreen-pulled-down(float /* dy */);
    callback homescreen-pull-released();

    in-out property <string> app-search-query: "";
    callback app-search-query-changed(string);
    callback app-search-accepted(string);

    // Wallpaper properties
    in property <bool> has-wallpaper: false;
    in property <image> wallpaper-image;
    in property <bool> has-blurred-wallpaper: false;
    in property <image> wallpaper-blurred-image;
    in property <string> current-wallpaper-path: "";
    in property <[WallpaperItem]> wallpapers: [];
    in property <[FolderItem]> wallpaper-folders: [];
    in property <[FileEntry]> file-entries: [];
    in property <string> current-browse-path: "/home/nyl";

    in-out property <bool> show-context-menu: false;
    in-out property <bool> show-wallpaper-picker: false;

    // Multi-page sliding workspace state (Continuous physics)
    in-out property <float> page-scroll: root.current-page * 1.0;
    property <bool> is-dragging-pages: false;

    animate page-scroll {
        duration: is-dragging-pages ? 0ms : 280ms;
        easing: cubic-bezier(0.18, 0.9, 0.25, 1.0);
    }

    // App Drawer pull-up gesture state (Continuous physics driven by Spring engine)
    in-out property <float> drawer-progress: root.active-mode == 2 ? 1.0 : 0.0;

    callback drawer-drag-delta(float);
    callback drawer-drag-released(float);
    callback drawer-open-requested();
    callback drawer-close-requested();

    callback select-wallpaper(string);
    callback clear-wallpaper();
    callback browse-to(string);
    callback add-scan-folder(string);
    callback remove-scan-folder(string);
    callback rescan-wallpapers();

    background: Theme.base-surface;
    clip: true;

    // Active Crisp Wallpaper rendering
    if root.has-wallpaper: Image {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        source: root.wallpaper-image;
        image-fit: cover;
    }

    // Progressive Blurred Wallpaper rendering (opacity modulated by drawer-progress!)
    if root.has-wallpaper && root.has-blurred-wallpaper: Image {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        source: root.wallpaper-blurred-image;
        image-fit: cover;
        opacity: root.is-dragging-app ? 0.0 : root.drawer-progress;
    }

    // Material 3 Expressive Scrim overlay (progressively darkens as drawer pulls up)
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: #000000;
        opacity: root.is-dragging-app ? 0.15 : (root.has-wallpaper ? (0.20 + (root.drawer-progress * 0.65)) : (root.drawer-progress * 0.85));
    }

    // Ambient Iris Glow in the background (when no wallpaper is set)
    if !root.has-wallpaper: Rectangle {
        x: parent.width * 0.1;
        y: parent.height * 0.15;
        width: 320px;
        height: 320px;
        border-radius: 160px;
        background: #25407026;
        opacity: Math.clamp(1.0 - root.drawer-progress, 0.0, 1.0);
    }

    // Edge Dwell Timer for dragging apps across homescreen pages (Android Workspace behavior)
    // Requires sustained 750ms dwell (5 ticks * 150ms) before flipping or creating a page
    edge-dwell-timer := Timer {
        interval: 150ms;
        running: root.is-dragging-app;
        triggered => {
            if (!root.is-dragging-app) {
                root.dwell-direction = 0;
                root.dwell-ticks = 0;
                return;
            }

            if (root.drag-x > parent.width - 45px) {
                if (root.dwell-direction == 1) {
                    root.dwell-ticks += 1;
                    // 5 ticks * 150ms = 750ms dwell time before flipping or creating new page
                    if (root.dwell-ticks >= 5) {
                        root.dwell-ticks = 0;
                        if (root.current-page < 4) { // Max 5 pages (0..4)
                            root.current-page += 1;
                            root.page-scroll = root.current-page;
                            if (root.current-page >= root.num-pages) {
                                root.num-pages = root.current-page + 1;
                            }
                        }
                    }
                } else {
                    root.dwell-direction = 1;
                    root.dwell-ticks = 1;
                }
            } else if (root.drag-x < 45px && root.current-page > 0) {
                if (root.dwell-direction == -1) {
                    root.dwell-ticks += 1;
                    if (root.dwell-ticks >= 5) {
                        root.dwell-ticks = 0;
                        root.current-page -= 1;
                        root.page-scroll = root.current-page;
                    }
                } else {
                    root.dwell-direction = -1;
                    root.dwell-ticks = 1;
                }
            } else {
                root.dwell-direction = 0;
                root.dwell-ticks = 0;
            }
        }
    }

    // =========================================================================
    // MODE 0: MULTI-PAGE HOMESCREEN WORKSPACE (Material 3 Expressive)
    // =========================================================================
    homescreen-workspace := Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        // As App Drawer is pulled up, homescreen content progressively fades and recedes, but reveals 100% during app drag
        opacity: root.is-dragging-app ? 1.0 : Math.clamp(1.0 - (root.drawer-progress * 1.6), 0.0, 1.0);
        visible: (root.is-dragging-app || self.opacity > 0.01) && (root.active-mode == 0 || root.active-mode == 2);

        // Background gesture listener:
        // - Dragging UP pulls up App Drawer interactively with 1:1 finger tracking
        // - Dragging DOWN pulls down Quick Settings
        // - Dragging LEFT/RIGHT smoothly scrolls between homescreen pages with spring physics
        // - Tap and Hold (450ms) opens Android-style Homescreen Context Menu
        // - Tap exits edit mode
        if !root.is-folder-open && !root.is-dragging-app: TouchArea {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;

            property <float> start-x: 0.0;
            property <float> start-y: 0.0;
            property <float> start-page-scroll: 0.0;
            property <bool> is-down: false;
            property <int> drag-gesture: 0; // 0: none/evaluating, 1: horizontal page, 2: drawer pull-up, 3: quick settings pull-down
            property <bool> hold-triggered: false;

            hold-timer := Timer {
                interval: 450ms;
                running: false;
                triggered => {
                    if (is-down && !hold-triggered && drag-gesture == 0 && !root.is-dragging-app && root.active-mode == 0) {
                        hold-triggered = true;
                        root.show-context-menu = true;
                    }
                }
            }

            property <float> last-drawer-y: 0.0;
            property <float> drawer-drag-velocity: 0.0;

            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    self.start-x = self.mouse-x / 1px;
                    self.start-y = self.mouse-y / 1px;
                    self.last-drawer-y = self.mouse-y / 1px;
                    self.drawer-drag-velocity = 0.0;
                    self.start-page-scroll = root.page-scroll;
                    self.is-down = true;
                    self.drag-gesture = 0;
                    self.hold-triggered = false;
                    hold-timer.running = true;
                } else if (event.kind == PointerEventKind.move) {
                    if (self.is-down) {
                        let dx = (self.mouse-x / 1px) - self.start-x;
                        let dy = (self.mouse-y / 1px) - self.start-y;

                        if (Math.abs(dx) > 10.0 || Math.abs(dy) > 10.0) {
                            hold-timer.running = false;
                        }

                        // Determine gesture mode if not locked
                        if (self.drag-gesture == 0) {
                            if (root.active-mode == 0 && Math.abs(dx) > 12.0 && Math.abs(dx) > Math.abs(dy) * 1.1) {
                                self.drag-gesture = 1; // Horizontal page scrolling
                                root.is-dragging-pages = true;
                            } else if (dy < -12.0 && Math.abs(dy) > Math.abs(dx) * 1.1) {
                                self.drag-gesture = 2; // Pulling UP App Drawer
                            } else if (root.active-mode == 0 && dy > 12.0 && dy > Math.abs(dx) * 1.1) {
                                self.drag-gesture = 3; // Pulling DOWN Quick Settings
                            }
                        }

                        if (self.drag-gesture == 1) {
                            // Drag pages interactively: swiping left (dx < 0) advances to next page
                            let delta-pages = dx / 380.0;
                            let max-page = Math.max(0.0, (root.num-pages - 1) * 1.0);
                            root.page-scroll = Math.clamp(self.start-page-scroll - delta-pages, -0.15, max-page + 0.15);
                        } else if (self.drag-gesture == 2) {
                            // Drag drawer interactively with incremental 1:1 touch response
                            let cur-y = self.mouse-y / 1px;
                            let delta = cur-y - self.last-drawer-y;
                            self.drawer-drag-velocity = self.drawer-drag-velocity * 0.6 + ((-delta / 873.0) / 0.016) * 0.4;
                            self.last-drawer-y = cur-y;
                            root.drawer-drag-delta(-delta / 873.0);
                        } else if (self.drag-gesture == 3) {
                            // Pull down quick settings
                            root.homescreen-pulled-down(dy);
                        }
                    }
                } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    hold-timer.running = false;
                    if (self.is-down) {
                        self.is-down = false;
                        let dx = (self.mouse-x / 1px) - self.start-x;
                        let dy = (self.mouse-y / 1px) - self.start-y;

                        if (self.drag-gesture == 1) {
                            // Release horizontal page scroll: snap with spring physics to target page
                            root.is-dragging-pages = false;
                            let max-p = root.num-pages - 1;
                            let target = dx < -35.0 ? (Math.round(self.start-page-scroll) + 1) : (dx > 35.0 ? (Math.round(self.start-page-scroll) - 1) : Math.round(root.page-scroll));
                            let clamped-target = Math.clamp(target, 0, max-p);
                            root.current-page = clamped-target;
                            root.page-scroll = clamped-target * 1.0;
                        } else if (self.drag-gesture == 2) {
                            // Release drawer pull-up: snap with spring physics
                            root.drawer-drag-released(self.drawer-drag-velocity);
                        } else if (self.drag-gesture == 3) {
                            root.homescreen-pull-released();
                        } else if (self.drag-gesture == 0 && Math.abs(dx) < 15.0 && Math.abs(dy) < 15.0) {
                            if (root.is-editing) {
                                root.is-editing = false;
                            }
                        }
                        self.drag-gesture = 0;
                    }
                }
            }
        }

        // Top At-a-Glance Clock & Weather Widget (Page 0, slides left with page-scroll)
        Rectangle {
            x: 20px - (root.page-scroll * 380px);
            y: 54px;
            width: parent.width - 40px;
            height: 84px;
            opacity: Math.clamp(1.0 - (root.page-scroll * 1.6), 0.0, 1.0);
            visible: self.opacity > 0.01;

            VerticalLayout {
                spacing: 4px;
                alignment: start;

                Text {
                    text: root.time-text;
                    font-size: Theme.font-clock-large;
                    font-weight: 800;
                    color: Theme.on-surface;
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    Text {
                        text: root.date-text;
                        font-size: Theme.font-body;
                        font-weight: 600;
                        color: Theme.on-surface-variant;
                        vertical-alignment: center;
                    }

                    // Weather Pill
                    Rectangle {
                        height: 26px;
                        border-radius: 13px;
                        background: #24212c;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            alignment: center;

                            Text {
                                text: "⛅";
                                font-size: 13px;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "21°C Clear";
                                font-size: 11.5px;
                                font-weight: 600;
                                color: Theme.primary;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Top Subtle Page Label on Pages 1+ (Slides in when page-scroll > 0)
        Rectangle {
            x: 20px + ((1.0 - root.page-scroll) * 380px);
            y: 56px;
            width: parent.width - 40px;
            height: 36px;
            opacity: Math.clamp(root.page-scroll * 1.5 - 0.2, 0.0, 1.0);
            visible: self.opacity > 0.01;

            HorizontalLayout {
                alignment: space-between;

                Text {
                    text: "Page \{Math.min(root.num-pages, Math.round(root.page-scroll) + 1)}";
                    font-size: Theme.font-title;
                    font-weight: 700;
                    color: Theme.on-surface-variant;
                    vertical-alignment: center;
                }

                Text {
                    text: "Swipe right for home";
                    font-size: Theme.font-label;
                    color: Theme.outline-variant;
                    vertical-alignment: center;
                }
            }
        }

        // Drop Snap Target Preview Box on Homescreen Grid
        if root.is-dragging-app && !root.is-folder-open && root.drag-y < 760px: Rectangle {
            property <float> origin-y-f: root.current-page == 0 ? 152.0 : 96.0;
            property <int> snap-col: Math.clamp(Math.round(((root.drag-x / 1px) - 20.0) / 93.0), 0, 3);
            property <int> snap-row: Math.clamp(Math.round(((root.drag-y / 1px) - self.origin-y-f) / 105.0), 0, 3);

            x: 20px + (self.snap-col * 93px) + 6px + (72px - 58px) / 2;
            y: (self.origin-y-f * 1px) + (self.snap-row * 105px) + 4px;
            width: 58px;
            height: 58px;
            border-radius: 20px;
            background: #ADC6FF22;
            border-width: 2px;
            border-color: Theme.primary;
        }

        // Drop Snap Target Preview Box on Bottom Dock
        if root.is-dragging-app && !root.is-folder-open && root.drag-y >= 760px: Rectangle {
            x: (parent.width - 240px) / 2;
            y: 770px;
            width: 240px;
            height: 64px;
            border-radius: 32px;
            background: #ADC6FF22;
            border-width: 2px;
            border-color: Theme.primary;
        }

        // Dynamic 4x4 Grid Shortcuts with Continuous Multi-Page Sliding Animation
        for item[idx] in root.homescreen-items: Rectangle {
            property <float> page-diff: (item.page * 1.0) - root.page-scroll;
            property <bool> is-drag-hovered: root.is-dragging-app && !root.is-folder-open && root.dragging-app-item.id != item.id && item.page == root.current-page && Math.abs(root.drag-x - (self.x + 36px)) < 40px && Math.abs(root.drag-y - (self.y + 44px)) < 44px;
            // Render when within visible viewport or adjacent transitioning range
            visible: Math.abs(self.page-diff) < 1.25;
            opacity: (root.is-dragging-app && root.dragging-app-item.id == item.id) ? 0.0 : 1.0;

            x: 20px + (self.page-diff * 412px) + (item.x * 93px) + 6px;
            y: (item.page == 0 ? 152px : 96px) + (item.y * 105px);
            width: 72px;
            height: 88px;

            if self.is-drag-hovered: Rectangle {
                x: 4px;
                y: 0px;
                width: 64px;
                height: 64px;
                border-radius: 22px;
                border-width: 3px;
                border-color: item.is-folder ? #7CDB8A : #D0BCFF;
                background: item.is-folder ? #7CDB8A33 : #D0BCFF33;
                z: 100;

                Rectangle {
                    y: -14px;
                    x: (parent.width - self.width) / 2;
                    width: tag-txt.width + 12px;
                    height: 18px;
                    border-radius: 9px;
                    background: item.is-folder ? #23542B : #381E72;
                    border-width: 1px;
                    border-color: item.is-folder ? #7CDB8A : #D0BCFF;

                    tag-txt := Text {
                        text: item.is-folder ? "Add" : "Folder";
                        font-size: 10px;
                        font-weight: 700;
                        color: item.is-folder ? #A9FFAE : #EADDFF;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            ShortcutTile {
                item: item;
                is-editing: root.is-editing;
                show-label: true;
                base-x: parent.x;
                base-y: parent.y;

                clicked => {
                    if (item.is-folder) {
                        root.open-folder-requested(item.folder-id);
                    } else {
                        root.app-clicked(item.id);
                    }
                }
                remove-clicked => {
                    root.app-removed-from-homescreen(item.id);
                }
                long-pressed => {
                    root.is-editing = true;
                }
                drag-started(id, sx, sy) => {
                    root.is-dragging-app = true;
                    root.dragging-is-folder = item.is-folder;
                    root.dwell-direction = 0;
                    root.dwell-ticks = 0;
                    root.dragging-app-item = {
                        id: item.id,
                        name: item.name,
                        has-icon: item.has-icon,
                        icon: item.icon,
                    };
                    root.drag-x = sx;
                    root.drag-y = sy;
                }
                drag-moved(sx, sy) => {
                    root.drag-x = sx;
                    root.drag-y = sy;
                }
                drag-ended(id, sx, sy) => {
                    root.is-dragging-app = false;
                    root.dwell-direction = 0;
                    root.dwell-ticks = 0;
                    let drop-y = sy / 1px;
                    if (drop-y >= 760.0) {
                        root.app-pinned-to-dock(id);
                    } else if (drop-y < 760.0) {
                        root.app-dropped-on-homescreen(id, root.current-page, sx, sy);
                    }
                }
            }
        }

        // Empty Homescreen Hint on Page 0 when no shortcuts are pinned
        if root.homescreen-items.length == 0: VerticalLayout {
            x: 0px - (root.page-scroll * 380px);
            y: 320px;
            width: parent.width;
            alignment: center;
            spacing: 8px;
            opacity: Math.clamp(1.0 - (root.page-scroll * 1.6), 0.0, 1.0);
            visible: self.opacity > 0.01;

            Text {
                text: "✨";
                font-size: 28px;
                horizontal-alignment: center;
            }
            Text {
                text: "Swipe up to open App Drawer";
                font-size: Theme.font-label;
                color: Theme.on-surface-variant;
                horizontal-alignment: center;
            }
        }

        // Material 3 Expressive Worm Page Indicator (Slides smoothly with page-scroll)
        if root.num-pages > 1: Rectangle {
            x: 0px;
            y: 696px;
            width: parent.width;
            height: 14px;

            // Dot track
            HorizontalLayout {
                alignment: center;
                spacing: 12px;

                for p in root.num-pages: Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: #3f3c47;

                    TouchArea {
                        clicked => {
                            root.current-page = p;
                            root.page-scroll = p * 1.0;
                        }
                    }
                }
            }

            // Smooth gliding active indicator pill
            Rectangle {
                property <float> total-track-w: ((root.num-pages - 1) * 20.0);
                x: ((parent.width / 1px - 20.0 - self.total-track-w) / 2.0 * 1px) + (root.page-scroll * 20px);
                y: 3px;
                width: 20px;
                height: 8px;
                border-radius: 4px;
                background: Theme.primary;
            }
        }

        // Bottom Google Pixel Search Bar (Material 3 Expressive - no glass)
        Rectangle {
            x: 20px;
            y: 720px;
            width: parent.width - 40px;
            height: 52px;
            border-radius: 26px;
            background: #1e1b24;
            border-width: 0px;

            search-ta := TouchArea {
                property <float> last-y: 0.0;
                property <float> velocity: 0.0;
                property <float> total-pull: 0.0;
                property <bool> is-active: false;

                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        self.last-y = search-ta.mouse-y / 1px;
                        self.velocity = 0.0;
                        self.total-pull = 0.0;
                        self.is-active = true;
                    } else if (event.kind == PointerEventKind.move) {
                        if (self.is-active) {
                            let cur-y = search-ta.mouse-y / 1px;
                            let delta = cur-y - self.last-y;
                            self.total-pull = self.total-pull - delta;
                            self.velocity = self.velocity * 0.6 + ((-delta / 873.0) / 0.016) * 0.4;
                            self.last-y = cur-y;
                            root.drawer-drag-delta(-delta / 873.0);
                        }
                    } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                        if (self.is-active) {
                            self.is-active = false;
                            if (self.total-pull < 12.0) {
                                root.drawer-open-requested();
                            } else {
                                root.drawer-drag-released(self.velocity);
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                padding-left: 18px;
                padding-right: 18px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: center;

                    Text {
                        text: "G";
                        font-size: 19px;
                        font-weight: 800;
                        color: Theme.primary;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "Search apps & web...";
                        font-size: Theme.font-label;
                        color: #c4c6d0;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: center;

                    Text {
                        text: "🎙";
                        font-size: 16px;
                        color: Theme.primary;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "✦";
                        font-size: 16px;
                        color: #c4c6d0;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Persistent Mobile Bottom Dock (Fixed at bottom above nav bar)
        BottomDock {
            x: (parent.width - 380px) / 2;
            y: 786px;
            width: 380px;
            height: 68px;
            dock-apps: root.dock-apps;
            is-editing: root.is-editing;
            reject-drop: root.reject-dock-drop;
            app-clicked(id) => {
                root.app-clicked(id);
            }
            app-removed(id) => {
                root.app-removed-from-dock(id);
            }
            request-edit-mode => {
                root.is-editing = true;
            }
        }
    }

    // =========================================================================
    // FOLDER MODAL POPUP DIALOG (Like iOS / Android Folder Overlay)
    // =========================================================================
    if root.is-folder-open || (root.is-dragging-app && root.dragging-from-folder-id != ""): Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        z: 900;
        background: root.is-folder-open ? #00000088 : transparent;

        // Click outside closes folder
        TouchArea {
            enabled: root.is-folder-open;
            clicked => {
                root.is-folder-open = false;
            }
        }

        // Folder Card
        Rectangle {
            x: 36px;
            y: 180px;
            width: parent.width - 72px;
            height: 380px;
            border-radius: 28px;
            background: root.is-folder-open ? #1C1924F8 : transparent;
            border-width: root.is-folder-open ? 1.5px : 0px;
            border-color: root.is-folder-open ? #ffffff22 : transparent;
            drop-shadow-blur: root.is-folder-open ? 24px : 0px;
            drop-shadow-color: root.is-folder-open ? #000000AA : transparent;
            clip: true;
            opacity: root.is-folder-open ? 1.0 : 0.0;
            animate opacity { duration: 150ms; }

            VerticalLayout {
                padding: 24px;
                spacing: 16px;
                alignment: start;

                // Folder Title Header (Editable)
                HorizontalLayout {
                    alignment: space-between;

                    folder-name-input := TextInput {
                        text: root.open-folder-name;
                        font-size: 20px;
                        font-weight: 700;
                        color: Theme.on-surface;
                        vertical-alignment: center;
                        accepted => {
                            root.folder-renamed(root.open-folder-id, self.text);
                        }
                    }

                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 16px;
                        background: #322E3E;

                        Text {
                            text: "✕";
                            font-size: 13px;
                            font-weight: 700;
                            color: #FFFFFF;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            clicked => {
                                root.folder-renamed(root.open-folder-id, folder-name-input.text);
                                root.is-folder-open = false;
                            }
                        }
                    }
                }

                // Apps Grid inside Folder
                Flickable {
                    vertical-stretch: 1;
                    content-height: (root.open-folder-apps.length / 3 + 1) * 96px;

                    VerticalLayout {
                        spacing: 12px;
                        alignment: start;

                        for r in (root.open-folder-apps.length / 3 + 1): HorizontalLayout {
                            alignment: space-around;
                            for c in 3: Rectangle {
                                width: 72px;
                                height: 88px;
                                property <int> item-idx: r * 3 + c;
                                property <length> folder-slot-x: 60px + ((root.width - 336px) / 6) + (c * (72px + ((root.width - 336px) / 3)));
                                property <length> folder-slot-y: 252px + (r * 100px);

                                // Target Drop Preview Indicator inside Folder
                                if self.item-idx == root.folder-drag-target-idx && root.is-dragging-app && root.is-folder-open && root.dragging-from-folder-idx != self.item-idx: Rectangle {
                                    width: 58px;
                                    height: 58px;
                                    x: (parent.width - self.width) / 2;
                                    y: 0px;
                                    border-radius: 18px;
                                    border-width: 2px;
                                    border-color: Theme.primary;
                                    background: #ADC6FF22;
                                }

                                if self.item-idx < root.open-folder-apps.length: ShortcutTile {
                                    opacity: (root.is-dragging-app && root.dragging-from-folder-id != "" && root.dragging-from-folder-idx == parent.item-idx) ? 0.0 : 1.0;
                                    base-x: parent.folder-slot-x;
                                    base-y: parent.folder-slot-y;
                                    is-editing: root.is-editing;
                                    app: root.open-folder-apps[parent.item-idx];
                                    show-label: true;

                                    clicked => {
                                        root.is-folder-open = false;
                                        root.app-clicked(root.open-folder-apps[parent.item-idx].id);
                                    }
                                    long-pressed => {
                                        root.is-editing = true;
                                    }
                                    remove-clicked => {
                                        root.folder-item-removed(root.open-folder-id, root.open-folder-apps[parent.item-idx].id);
                                    }
                                    drag-started(id, sx, sy) => {
                                        root.is-dragging-app = true;
                                        root.dragging-is-folder = false;
                                        root.dragging-from-folder-id = root.open-folder-id;
                                        root.dragging-from-folder-idx = parent.item-idx;
                                        root.dragging-app-item = root.open-folder-apps[parent.item-idx];
                                        root.drag-x = sx;
                                        root.drag-y = sy;
                                    }
                                    drag-moved(sx, sy) => {
                                        root.drag-x = sx;
                                        root.drag-y = sy;
                                        // If dragged outside the folder card boundary, close folder and continue homescreen drag!
                                        if (root.is-folder-open) {
                                            if (sx < 36px || sx > root.width - 36px || sy < 160px || sy > 580px) {
                                                root.is-folder-open = false;
                                            }
                                        }
                                    }
                                    drag-ended(id, sx, sy) => {
                                        root.is-dragging-app = false;
                                        if (!root.is-folder-open) {
                                            // Dropped outside folder onto homescreen or dock!
                                            let drop-y = sy / 1px;
                                            if (drop-y >= 760.0) {
                                                root.app-pinned-to-dock(id);
                                            } else if (drop-y < 760.0) {
                                                root.app-dropped-on-homescreen(id, root.current-page, sx, sy);
                                            }
                                        } else {
                                            // Dropped inside folder: reorder items inside folder!
                                            let max-r = Math.max(0, (root.open-folder-apps.length - 1) / 3);
                                            let fc = Math.clamp(Math.floor(((sx / 1px) - 60.0) / 90.0), 0, 2);
                                            let fr = Math.clamp(Math.floor(((sy / 1px) - 252.0) / 100.0), 0, max-r);
                                            let target-idx = Math.clamp(fr * 3 + fc, 0, Math.max(0, root.open-folder-apps.length - 1));
                                            if (target-idx != root.dragging-from-folder-idx) {
                                                root.folder-apps-reordered(root.open-folder-id, root.dragging-from-folder-idx, target-idx);
                                            }
                                        }
                                        root.dragging-from-folder-id = "";
                                        root.dragging-from-folder-idx = -1;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // =========================================================================
    // =========================================================================
    // MODE 2: APP DRAWER (All Applications Overlay with Material 3 Expressive Physics)
    // =========================================================================
    app-drawer := Rectangle {
        x: 0px;
        y: 42px + (1.0 - root.drawer-progress) * (parent.height - 42px);
        width: parent.width;
        height: parent.height - 42px;
        opacity: root.is-dragging-app ? 0.0 : 1.0;
        visible: (!root.is-dragging-app) && (root.drawer-progress > 0.001);
        clip: true;

        animate opacity {
            duration: 150ms;
            easing: ease-out;
        }

        AppDrawer {
            drawer-progress: root.drawer-progress;
            installed-apps: root.installed-apps;
            is-open: root.drawer-progress > 0.1;
            search-query <=> root.app-search-query;
            search-query-changed(q) => {
                root.app-search-query-changed(q);
            }
            search-accepted(q) => {
                root.app-search-accepted(q);
            }
            app-clicked(id) => {
                root.app-clicked(id);
            }
            drawer-drag-delta(delta) => {
                root.drawer-drag-delta(delta);
            }
            drawer-drag-released(vel) => {
                root.drawer-drag-released(vel);
            }
            close-requested => {
                root.app-search-query = "";
                root.app-search-query-changed("");
                root.drawer-close-requested();
            }
            start-drag(id, item, sx, sy) => {
                root.is-dragging-app = true;
                root.dwell-direction = 0;
                root.dwell-ticks = 0;
                root.dragging-app-item = item;
                root.drag-x = sx;
                root.drag-y = sy;
            }
            drag-moved(sx, sy) => {
                root.drag-x = sx;
                root.drag-y = sy;
            }
            drag-ended(id, sx, sy) => {
                root.is-dragging-app = false;
                root.dwell-direction = 0;
                root.dwell-ticks = 0;
                root.active-mode = 0; // Return to homescreen
                root.drawer-progress = 0.0;
                let drop-y = sy / 1px;
                if (drop-y >= 760.0) {
                    root.app-pinned-to-dock(id);
                } else if (drop-y < 760.0) {
                    root.app-dropped-on-homescreen(id, root.current-page, sx, sy);
                }
            }
        }
    }

    // Floating drag overlay when moving an app across homescreen or to dock
    if root.is-dragging-app: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        z: 1000;

        // Floating App/Folder Icon under pointer
        Rectangle {
            x: Math.clamp(root.drag-x - 30px, 0px, parent.width - 60px);
            y: Math.clamp(root.drag-y - 30px, 0px, parent.height - 60px);
            width: 60px;
            height: 60px;
            border-radius: 20px;
            background: root.dragging-is-folder ? #1F1C25F0 : #2b2832EE;
            border-width: 2px;
            border-color: Theme.primary;

            if root.dragging-is-folder: Text {
                text: "📁";
                font-size: 28px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if !root.dragging-is-folder && root.dragging-app-item.has-icon: Image {
                source: root.dragging-app-item.icon;
                width: 44px;
                height: 44px;
                x: 8px;
                y: 8px;
            }
            if !root.dragging-is-folder && !root.dragging-app-item.has-icon: Text {
                text: "📱";
                font-size: 26px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    // =========================================================================
    // MODE 3: ACTIVE REAL WAYLAND APPLICATION CANVAS (Composited by penumbra-comp)
    // Mode 3 (native app) is rendered on Layer 1 by the compositor; homescreen stays as clean background.

    // =========================================================================
    // Overview (Mode 1) is rendered natively by the compositor on Layer 1 with 120Hz physics.

    // Android Homescreen Long-Press Context Menu
    HomescreenContextMenu {
        width: 100%;
        height: 100%;
        is-open <=> root.show-context-menu;
        wallpaper-clicked => {
            root.show-wallpaper-picker = true;
        }
        edit-clicked => {
            root.is-editing = true;
        }
        close => {
            root.show-context-menu = false;
        }
    }

    // Full Wallpaper & Style Picker modal
    WallpaperPicker {
        width: 100%;
        height: 100%;
        is-open <=> root.show-wallpaper-picker;
        current-wallpaper-path: root.current-wallpaper-path;
        has-wallpaper: root.has-wallpaper;
        current-wallpaper-image: root.wallpaper-image;
        wallpapers: root.wallpapers;
        folders: root.wallpaper-folders;
        file-entries: root.file-entries;
        current-browse-path: root.current-browse-path;

        select-wallpaper(p) => {
            root.select-wallpaper(p);
        }
        clear-wallpaper => {
            root.clear-wallpaper();
        }
        browse-to(p) => {
            root.browse-to(p);
        }
        add-scan-folder(p) => {
            root.add-scan-folder(p);
        }
        remove-scan-folder(p) => {
            root.remove-scan-folder(p);
        }
        rescan-wallpapers => {
            root.rescan-wallpapers();
        }
        close => {
            root.show-wallpaper-picker = false;
        }
    }
}
