import { Theme } from "theme.slint";

// Bottom gesture bar: fixed system inset at y 883..915 (32px), composited above apps.
// Gesture classification (flick -> home, drag & hold -> overview) happens in Rust
// (penumbra_gestures::NavGestureRecognizer); this component only reports raw touches.
export component NavBar inherits Rectangle {
    in-out property <bool> is-pressed: false;
    in-out property <length> drag-offset-x: 0px;
    in-out property <length> drag-offset-y: 0px;
    // Solid dark container while an app or the overview is on screen.
    in property <bool> solid: false;

    callback gesture-triggered(string); // "home", "recents"
    callback touch-down(float, float);
    callback touch-move(float, float);
    callback touch-up(float, float);
    callback keyboard-toggle-clicked();

    height: 32px;
    background: root.solid ? #000000 : transparent;
    animate background { duration: 150ms; }

    // Centered gesture pill indicator, follows the finger upwards slightly
    Rectangle {
        x: (parent.width - self.width) / 2 + root.drag-offset-x * 0.3;
        y: (parent.height - self.height) / 2 + Math.max(-10px, Math.min(0px, root.drag-offset-y * 0.15));
        width: root.is-pressed ? 96px : 72px;
        height: root.is-pressed ? 5px : 4px;
        border-radius: Theme.radius-pill;
        background: root.is-pressed ? #FFFFFF : #FFFFFFCC;

        animate width { duration: 120ms; easing: ease-out; }
        animate height { duration: 120ms; easing: ease-out; }
        animate background { duration: 120ms; easing: ease-out; }
    }

    // Right-aligned keyboard toggle button (Android 17 Material You style)
    Rectangle {
        x: parent.width - 52px;
        y: (parent.height - 24px) / 2;
        width: 44px;
        height: 24px;
        border-radius: 12px;
        background: kbd-ta.pressed ? #ffffff33 : #ffffff18;
        border-width: 1px;
        border-color: #ffffff26;

        animate background { duration: 100ms; }

        Path {
            width: 18px;
            height: 14px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M4 6 H20 A 2 2 0 0 1 22 8 V16 A 2 2 0 0 1 20 18 H4 A 2 2 0 0 1 2 16 V8 A 2 2 0 0 1 4 6 Z M6 9 H8 V11 H6 Z M10 9 H12 V11 H10 Z M14 9 H16 V11 H14 Z M18 9 H18.01 V11 H18 Z M6 13 H8 V15 H6 Z M10 14 H14 V15 H10 Z M16 13 H18 V15 H16 Z";
            stroke: #a8c7fa;
            stroke-width: 1.8px;
            fill: transparent;
        }

        kbd-ta := TouchArea {
            clicked => {
                root.keyboard-toggle-clicked();
            }
        }
    }

    touch-area := TouchArea {
        x: 0px;
        y: 0px;
        width: parent.width - 60px;
        height: 100%;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.is-pressed = true;
                root.touch-down(touch-area.mouse-x / 1px, touch-area.mouse-y / 1px);
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.is-pressed = false;
                root.touch-up(touch-area.mouse-x / 1px, touch-area.mouse-y / 1px);
                root.drag-offset-x = 0px;
                root.drag-offset-y = 0px;
            }
        }

        moved => {
            if (root.is-pressed) {
                root.drag-offset-x = touch-area.mouse-x - (root.width / 2);
                root.drag-offset-y = touch-area.mouse-y - (root.height / 2);
                root.touch-move(touch-area.mouse-x / 1px, touch-area.mouse-y / 1px);
            }
        }
    }
}
