// Font-independent stroke icons on a 24x24 grid. Unknown names render the app grid.
export component Icon inherits Rectangle {
    in property <string> name;
    in property <color> icon-color: #ffffff;
    in property <length> icon-size: 20px;

    property <string> d: root.name == "close" ? "M6 6 L18 18 M18 6 L6 18"
        : root.name == "plus" ? "M12 5 L12 19 M5 12 L19 12"
        : root.name == "chevron-left" ? "M15 5 L8 12 L15 19"
        : root.name == "chevron-right" ? "M9 5 L16 12 L9 19"
        : root.name == "edit" ? "M4 20 L8 19 L19 8 L16 5 L5 16 Z"
        : root.name == "settings" ? "M4 7 L20 7 M4 17 L20 17 M9 4 L9 10 M15 14 L15 20"
        : root.name == "power" ? "M6.34 6.34 A 8 8 0 1 0 17.66 6.34 M12 3 L12 12"
        : root.name == "brightness" ? "M8 12 A 4 4 0 1 0 16 12 A 4 4 0 1 0 8 12 Z M12 2 L12 4 M12 20 L12 22 M2 12 L4 12 M20 12 L22 12 M4.93 4.93 L6.34 6.34 M17.66 17.66 L19.07 19.07 M4.93 19.07 L6.34 17.66 M17.66 6.34 L19.07 4.93"
        : root.name == "volume" ? "M4 9 L8 9 L13 5 L13 19 L8 15 L4 15 Z M16 9 Q18.5 12 16 15 M18.5 6.5 Q22 12 18.5 17.5"
        : root.name == "music" ? "M9 18 L9 6 L19 4 L19 16 M5 18 A 2 2 0 1 0 9 18 A 2 2 0 1 0 5 18 Z M15 16 A 2 2 0 1 0 19 16 A 2 2 0 1 0 15 16 Z"
        : root.name == "wifi" ? "M2 9 Q12 -1 22 9 M5 12.5 Q12 6 19 12.5 M8.5 16 Q12 12.5 15.5 16 M11.5 19 A 0.5 0.5 0 1 0 12.5 19 A 0.5 0.5 0 1 0 11.5 19 Z"
        : root.name == "bluetooth" ? "M7 7 L17 17 L12 22 L12 2 L17 7 L7 17"
        : root.name == "flashlight" ? "M9 3 L15 3 L15 7 L13 9 L13 21 L11 21 L11 9 L9 7 Z"
        : root.name == "dnd" ? "M3 12 A 9 9 0 1 0 21 12 A 9 9 0 1 0 3 12 Z M7 12 L17 12"
        : root.name == "rotation" ? "M20 12 A 8 8 0 1 1 12 4 M9 1.5 L12 4 L9 6.5"
        : root.name == "battery" ? "M3 8 L19 8 L19 16 L3 16 Z M21 11 L21 13 M6 11 L13 11 L13 13 L6 13 Z"
        : root.name == "airplane" ? "M12 3 L12 10 L21 14 L21 16 L12 13.5 L12 19 L15 21 L15 22 L12 21 L9 22 L9 21 L12 19"
        : root.name == "hotspot" ? "M11.5 12 A 0.5 0.5 0 1 0 12.5 12 A 0.5 0.5 0 1 0 11.5 12 Z M6.5 6.5 Q3 12 6.5 17.5 M17.5 6.5 Q21 12 17.5 17.5 M9.5 9.5 Q7.5 12 9.5 14.5 M14.5 9.5 Q16.5 12 14.5 14.5"
        : root.name == "night" ? "M14 3 A 9 9 0 1 0 21 14 A 7 7 0 0 1 14 3 Z"
        : root.name == "recorder" ? "M12 3 A 9 9 0 1 0 12 21 A 9 9 0 1 0 12 3 Z M8 12 A 4 4 0 1 0 16 12 A 4 4 0 1 0 8 12 Z"
        : "M4 4 L10 4 L10 10 L4 10 Z M14 4 L20 4 L20 10 L14 10 Z M4 14 L10 14 L10 20 L4 20 Z M14 14 L20 14 L20 20 L14 20 Z";

    width: root.icon-size;
    height: root.icon-size;
    background: transparent;

    Path {
        width: root.width;
        height: root.height;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.d;
        stroke: root.icon-color;
        stroke-width: 2px;
        fill: transparent;
    }
}
