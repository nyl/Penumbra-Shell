import { Theme } from "theme.slint";
import { AppItem, HomescreenItem } from "app_item.slint";

export component ShortcutTile inherits Rectangle {
    in property <AppItem> app;
    in property <HomescreenItem> item;
    in property <bool> is-editing: false;
    in property <bool> show-label: true;
    in property <length> base-x: 0px;
    in property <length> base-y: 0px;

    property <bool> is-app-mode: root.app.id != "";
    property <string> tile-id: root.is-app-mode ? root.app.id : root.item.id;
    property <string> tile-name: root.is-app-mode ? root.app.name : root.item.name;
    property <bool> tile-has-icon: root.is-app-mode ? root.app.has-icon : root.item.has-icon;
    property <image> tile-icon: root.is-app-mode ? root.app.icon : root.item.icon;
    property <bool> tile-is-folder: !root.is-app-mode && root.item.is-folder;

    callback clicked();
    callback remove-clicked();
    callback long-pressed();
    callback drag-started(string, length, length);
    callback drag-moved(length, length);
    callback drag-ended(string, length, length);

    width: 72px;
    height: root.show-label ? 88px : 64px;
    background: transparent;

    // iOS Jiggle animation continuous offset
    property <int> jiggle-step: 0;
    property <length> jiggle-x: !root.is-editing ? 0px : (root.jiggle-step == 0 ? 1.5px : -1.5px);
    property <length> jiggle-y: !root.is-editing ? 0px : (root.jiggle-step == 0 ? -1px : 1px);

    animate jiggle-x { duration: 90ms; easing: ease-in-out; }
    animate jiggle-y { duration: 90ms; easing: ease-in-out; }

    jiggle-timer := Timer {
        interval: 110ms;
        running: root.is-editing;
        triggered => {
            root.jiggle-step = root.jiggle-step == 0 ? 1 : 0;
        }
    }

    // Long press detector state (> 400ms)
    property <float> touch-start-x: 0.0;
    property <float> touch-start-y: 0.0;
    property <bool> is-down: false;
    property <bool> is-dragging: false;

    lp-timer := Timer {
        interval: 400ms;
        running: false;
        triggered => {
            self.running = false;
            if (root.is-down) {
                root.is-dragging = true;
                let sx = root.base-x + (root.touch-start-x * 1px);
                let sy = root.base-y + (root.touch-start-y * 1px);
                root.long-pressed();
                root.drag-started(root.tile-id, sx, sy);
            }
        }
    }

    container := Rectangle {
        width: 100%;
        height: 100%;
        x: root.jiggle-x;
        y: root.jiggle-y;

        VerticalLayout {
            alignment: center;
            spacing: 5px;

            // Icon box
            icon-box := Rectangle {
                width: 56px;
                height: 56px;
                x: (parent.width - self.width) / 2;
                border-radius: 18px;
                background: root.tile-is-folder ? #1F1C25EE : #232029;
                border-width: 1px;
                border-color: root.is-editing ? #ADC6FF66 : (root.tile-is-folder ? #FFFFFF22 : Theme.specular-rim);
                clip: false;

                // Single App Icon
                if !root.tile-is-folder: Rectangle {
                    width: 100%;
                    height: 100%;
                    clip: true;
                    border-radius: 18px;

                    if root.tile-has-icon: Image {
                        source: root.tile-icon;
                        width: 40px;
                        height: 40px;
                        x: 8px;
                        y: 8px;
                    }

                    if !root.tile-has-icon: Text {
                        text: "📱";
                        font-size: 24px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // 2x2 Mini Folder Previews
                if root.item.is-folder: Rectangle {
                    width: 44px;
                    height: 44px;
                    x: 6px;
                    y: 6px;

                    // Slot 1 (top-left)
                    Rectangle {
                        x: 2px;
                        y: 2px;
                        width: 18px;
                        height: 18px;
                        border-radius: 5px;
                        background: #2C2836;
                        clip: true;
                        if root.item.has-prev-1: Image {
                            source: root.item.preview-1;
                            width: 14px;
                            height: 14px;
                            x: 2px;
                            y: 2px;
                        }
                    }

                    // Slot 2 (top-right)
                    Rectangle {
                        x: 24px;
                        y: 2px;
                        width: 18px;
                        height: 18px;
                        border-radius: 5px;
                        background: #2C2836;
                        clip: true;
                        if root.item.has-prev-2: Image {
                            source: root.item.preview-2;
                            width: 14px;
                            height: 14px;
                            x: 2px;
                            y: 2px;
                        }
                    }

                    // Slot 3 (bottom-left)
                    Rectangle {
                        x: 2px;
                        y: 24px;
                        width: 18px;
                        height: 18px;
                        border-radius: 5px;
                        background: #2C2836;
                        clip: true;
                        if root.item.has-prev-3: Image {
                            source: root.item.preview-3;
                            width: 14px;
                            height: 14px;
                            x: 2px;
                            y: 2px;
                        }
                    }

                    // Slot 4 (bottom-right)
                    Rectangle {
                        x: 24px;
                        y: 24px;
                        width: 18px;
                        height: 18px;
                        border-radius: 5px;
                        background: #2C2836;
                        clip: true;
                        if root.item.has-prev-4: Image {
                            source: root.item.preview-4;
                            width: 14px;
                            height: 14px;
                            x: 2px;
                            y: 2px;
                        }
                    }
                }

                // Delete badge in top-right corner during edit mode
                if root.is-editing: delete-badge := Rectangle {
                    x: parent.width - 12px;
                    y: -6px;
                    width: 22px;
                    height: 22px;
                    border-radius: 11px;
                    background: #E53935;
                    border-width: 1.5px;
                    border-color: #ffffff;
                    z: 100;

                    Text {
                        text: "✕";
                        font-size: 11px;
                        font-weight: 800;
                        color: #ffffff;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    badge-ta := TouchArea {
                        clicked => {
                            root.remove-clicked();
                        }
                    }
                }
            }

            if root.show-label: Text {
                text: root.tile-name;
                font-size: 11px;
                font-weight: 500;
                color: Theme.on-surface;
                horizontal-alignment: center;
                overflow: elide;
                max-width: 72px;
            }
        }
    }

    // Touch interaction for tap, long-press, and drag reorder
    tile-ta := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.touch-start-x = tile-ta.mouse-x / 1px;
                root.touch-start-y = tile-ta.mouse-y / 1px;
                root.is-down = true;
                root.is-dragging = false;
                lp-timer.running = true;
            } else if (event.kind == PointerEventKind.move) {
                if (root.is-dragging) {
                    let sx = root.base-x + tile-ta.mouse-x;
                    let sy = root.base-y + tile-ta.mouse-y;
                    root.drag-moved(sx, sy);
                } else if (root.is-down) {
                    let dx = Math.abs((tile-ta.mouse-x / 1px) - root.touch-start-x);
                    let dy = Math.abs((tile-ta.mouse-y / 1px) - root.touch-start-y);
                    if (dx > 12.0 || dy > 12.0) {
                        lp-timer.running = false;
                    }
                }
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                lp-timer.running = false;
                if (root.is-dragging) {
                    root.is-dragging = false;
                    root.is-down = false;
                    let sx = root.base-x + tile-ta.mouse-x;
                    let sy = root.base-y + tile-ta.mouse-y;
                    root.drag-ended(root.tile-id, sx, sy);
                } else if (root.is-down) {
                    root.is-down = false;
                    let dx = Math.abs((tile-ta.mouse-x / 1px) - root.touch-start-x);
                    let dy = Math.abs((tile-ta.mouse-y / 1px) - root.touch-start-y);
                    if (dx < 12.0 && dy < 12.0) {
                        root.clicked();
                    }
                }
            }
        }
    }
}
