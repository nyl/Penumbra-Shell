export global Theme {
    // Material 3 Expressive OLED Pitch-Black Palette
    out property <color> base-surface: #0D0B10;
    out property <color> surface-lowest: #17151D;
    out property <color> surface-low: #1E1B24;
    out property <color> surface-high: #27232E;
    out property <color> surface-container-high: #27232E;
    out property <color> surface-highest: #332E3C;
    out property <color> surface-variant: #44474F;

    // Accent Roles
    out property <color> primary: #ADC6FF;          // Dynamic Iris Blue
    out property <color> on-primary: #002E69;
    out property <color> primary-container: #254070;
    out property <color> on-primary-container: #D8E2FF;
    out property <color> secondary: #BFC6DC;
    out property <color> on-secondary: #283141;

    // Content Roles
    out property <color> on-surface: #E3E2E6;
    out property <color> on-surface-variant: #C4C6D0;
    out property <color> outline: #8E9099;
    out property <color> outline-variant: #44474F;

    // Sensor / Privacy Indicator
    out property <color> privacy-green: #48E885;
    out property <color> privacy-green-glow: #48E88533;

    // Specular Rim Highlight
    out property <color> specular-rim: #ffffff14;    // rgba(255, 255, 255, 0.08)
    out property <color> specular-rim-active: #ffffff2e;

    // Geometry Radii
    out property <length> radius-pill: 9999px;
    out property <length> radius-tile: 28px;
    out property <length> radius-card: 36px;
    out property <length> radius-small: 16px;
    out property <length> radius-xs: 8px;

    // Font Sizes
    out property <length> font-headline: 32px;
    out property <length> font-clock-large: 64px;
    out property <length> font-clock-mid: 42px;
    out property <length> font-title: 19px;
    out property <length> font-body: 14px;
    out property <length> font-label: 12px;
    out property <length> font-caption: 11px;
}
