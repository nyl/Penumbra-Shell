import { Theme } from "theme.slint";

component SliderPill inherits Rectangle {
    in-out property <float> value: 0.75;
    in property <string> icon-text: "☀";
    in property <string> label: "Brightness";
    callback changed(float);

    height: 48px;
    border-radius: Theme.radius-pill;
    background: Theme.surface-high;
    border-width: 1px;
    border-color: Theme.specular-rim;
    clip: true;

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width * Math.clamp(root.value, 0.0, 1.0);
        height: parent.height;
        background: Theme.primary;
        border-radius: Theme.radius-pill;
    }

    slider-touch := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.value = Math.clamp(slider-touch.mouse-x / root.width, 0.0, 1.0);
                root.changed(root.value);
            }
        }
        moved => {
            if (slider-touch.pressed) {
                root.value = Math.clamp(slider-touch.mouse-x / root.width, 0.0, 1.0);
                root.changed(root.value);
            }
        }
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 10px;
            alignment: center;

            Text {
                text: root.icon-text;
                font-size: 16px;
                color: root.value > 0.15 ? Theme.on-primary : Theme.on-surface;
                vertical-alignment: center;
            }

            Text {
                text: root.label;
                font-size: Theme.font-label;
                font-weight: 600;
                color: root.value > 0.4 ? Theme.on-primary : Theme.on-surface;
                vertical-alignment: center;
            }
        }

        Text {
            text: "\{Math.round(root.value * 100.0)}%";
            font-size: Theme.font-caption;
            font-weight: 700;
            color: root.value > 0.85 ? Theme.on-primary : Theme.on-surface-variant;
            vertical-alignment: center;
        }
    }
}

component ToggleTile inherits Rectangle {
    in-out property <bool> is-active: false;
    in property <string> icon-text: "󰤨";
    in property <string> title: "Toggle";
    in property <string> subtitle: "Status";
    callback clicked();

    height: 64px;
    border-radius: Theme.radius-tile;
    background: root.is-active ? Theme.primary : Theme.surface-high;
    border-width: 1px;
    border-color: root.is-active ? Theme.specular-rim-active : Theme.specular-rim;

    animate background { duration: 160ms; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }
    animate border-color { duration: 160ms; easing: ease-out; }

    TouchArea {
        clicked => {
            root.is-active = !root.is-active;
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        alignment: start;

        Rectangle {
            width: 36px;
            height: 36px;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-pill;
            background: root.is-active ? Theme.on-primary : Theme.surface-highest;

            animate background { duration: 160ms; easing: ease-out; }

            Text {
                text: root.icon-text;
                font-size: 16px;
                color: root.is-active ? Theme.primary : Theme.on-surface;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            Text {
                text: root.title;
                font-size: 13px;
                font-weight: 700;
                color: root.is-active ? Theme.on-primary : Theme.on-surface;
                overflow: elide;
            }

            Text {
                text: root.subtitle;
                font-size: 11px;
                color: root.is-active ? Theme.on-primary : Theme.on-surface-variant;
                overflow: elide;
            }
        }
    }
}

component CompactToggleIcon inherits Rectangle {
    in-out property <bool> is-active: false;
    in property <string> icon-text: "󰤨";
    in property <string> label: "Wi-Fi";
    callback clicked();

    width: 78px;
    height: 64px;
    border-radius: 18px;
    background: root.is-active ? Theme.primary : Theme.surface-high;
    border-width: 1px;
    border-color: root.is-active ? Theme.specular-rim-active : Theme.specular-rim;

    animate background { duration: 160ms; easing: ease-out; }

    TouchArea {
        clicked => {
            root.is-active = !root.is-active;
            root.clicked();
        }
    }

    VerticalLayout {
        alignment: center;
        spacing: 4px;

        Text {
            text: root.icon-text;
            font-size: 20px;
            color: root.is-active ? Theme.on-primary : Theme.on-surface;
            horizontal-alignment: center;
        }

        Text {
            text: root.label;
            font-size: 11px;
            font-weight: 600;
            color: root.is-active ? Theme.on-primary : Theme.on-surface-variant;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}

export component QuickSettingsSlider inherits Rectangle {
    in-out property <length> slide-offset-y: -915px; // Fully retracted
    in property <float> expansion-progress: 0.0;     // 0.0 to 1.0 (0.0 = closed, 0.35 = compact, 1.0 = full)

    in-out property <float> brightness: 0.75;
    in-out property <float> volume: 0.60;
    in-out property <string> time-text: "12:00";
    in-out property <string> date-text: "Wednesday, Oct 21";
    in-out property <string> carrier-text: "Penumbra 5G";

    in-out property <bool> tile-internet: true;
    in-out property <bool> tile-bluetooth: true;
    in-out property <bool> tile-flashlight: false;
    in-out property <bool> tile-dnd: false;
    in-out property <bool> tile-hotspot: false;
    in-out property <bool> tile-rotate: true;
    in-out property <bool> tile-airplane: false;
    in-out property <bool> tile-battery-saver: false;

    callback close-requested();
    callback power-action();
    callback settings-action();
    callback brightness-changed(float);
    callback volume-changed(float);
    callback drag-delta(length /* dy */);
    callback drag-released(length /* current_y */, float /* velocity */);

    // Dynamic backdrop scrim: darkens smoothly as shade expands
    property <float> scrim-alpha: Math.clamp((root.slide-offset-y + 915px) / 915px * 0.55, 0.0, 0.55);

    background: #000000.with-alpha(root.scrim-alpha);

    // Tap backdrop below the shade to dismiss
    scrim-touch := TouchArea {
        x: 0px;
        y: Math.max(0px, root.slide-offset-y + 915px);
        width: parent.width;
        height: Math.max(0px, parent.height - self.y);
        clicked => {
            root.close-requested();
        }
    }

    sliding-chassis := Rectangle {
        y: root.slide-offset-y;
        width: 100%;
        height: 915px;
        background: #141218f2;
        border-bottom-left-radius: 28px;
        border-bottom-right-radius: 28px;
        clip: true;

        // Specular highlight line along bottom edge
        Rectangle {
            x: 0px;
            y: parent.height - 1.5px;
            width: parent.width;
            height: 1.5px;
            background: #ffffff33;
        }

        VerticalLayout {
            padding-top: 44px;
            padding-bottom: 16px;
            padding-left: 18px;
            padding-right: 18px;
            spacing: 14px;

            // Header: Clock, Date/Carrier, Settings, Power
            HorizontalLayout {
                alignment: space-between;

                VerticalLayout {
                    spacing: 2px;
                    alignment: center;

                    Text {
                        text: root.time-text;
                        font-size: root.expansion-progress > 0.35 ? 32px : 26px;
                        font-weight: 800;
                        color: Theme.on-surface;
                    }

                    Text {
                        text: "\{root.date-text} • \{root.carrier-text}";
                        font-size: 12px;
                        font-weight: 500;
                        color: Theme.on-surface-variant;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;

                    Rectangle {
                        width: 38px;
                        height: 38px;
                        border-radius: Theme.radius-pill;
                        background: Theme.surface-high;
                        border-width: 1px;
                        border-color: Theme.specular-rim;

                        Text {
                            text: "⚙";
                            font-size: 15px;
                            color: Theme.on-surface;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }

                        TouchArea {
                            clicked => { root.settings-action(); }
                        }
                    }

                    Rectangle {
                        width: 38px;
                        height: 38px;
                        border-radius: Theme.radius-pill;
                        background: #FFB4AB26;
                        border-width: 1px;
                        border-color: #FFB4AB4D;

                        Text {
                            text: "⏻";
                            font-size: 15px;
                            color: #FFB4AB;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }

                        TouchArea {
                            clicked => { root.power-action(); }
                        }
                    }
                }
            }

            // STAGE 1: Compact View (expansion-progress <= 0.35)
            if root.expansion-progress <= 0.35: HorizontalLayout {
                spacing: 12px;
                alignment: space-between;

                CompactToggleIcon {
                    is-active <=> root.tile-internet;
                    icon-text: "󰤨";
                    label: "Internet";
                }
                CompactToggleIcon {
                    is-active <=> root.tile-bluetooth;
                    icon-text: "󰂯";
                    label: "Bluetooth";
                }
                CompactToggleIcon {
                    is-active <=> root.tile-airplane;
                    icon-text: "✈";
                    label: "Airplane";
                }
                CompactToggleIcon {
                    is-active <=> root.tile-flashlight;
                    icon-text: "󰛨";
                    label: "Flashlight";
                }
            }

            // STAGE 2: Full Expansion (expansion-progress > 0.35)
            if root.expansion-progress > 0.35: VerticalLayout {
                spacing: 12px;

                // 2x4 Toggle Grid
                // Row 1
                HorizontalLayout {
                    spacing: 12px;
                    ToggleTile {
                        width: (parent.width - 12px) / 2;
                        is-active <=> root.tile-internet;
                        icon-text: "󰤨";
                        title: "Internet";
                        subtitle: root.tile-internet ? root.carrier-text : "Off";
                    }
                    ToggleTile {
                        width: (parent.width - 12px) / 2;
                        is-active <=> root.tile-bluetooth;
                        icon-text: "󰂯";
                        title: "Bluetooth";
                        subtitle: root.tile-bluetooth ? "Connected" : "Off";
                    }
                }

                // Row 2
                HorizontalLayout {
                    spacing: 12px;
                    ToggleTile {
                        width: (parent.width - 12px) / 2;
                        is-active <=> root.tile-flashlight;
                        icon-text: "󰛨";
                        title: "Flashlight";
                        subtitle: root.tile-flashlight ? "Active" : "Off";
                    }
                    ToggleTile {
                        width: (parent.width - 12px) / 2;
                        is-active <=> root.tile-dnd;
                        icon-text: "󰂲";
                        title: "Do Not Disturb";
                        subtitle: root.tile-dnd ? "Priority only" : "Off";
                    }
                }

                // Row 3
                HorizontalLayout {
                    spacing: 12px;
                    ToggleTile {
                        width: (parent.width - 12px) / 2;
                        is-active <=> root.tile-hotspot;
                        icon-text: "󰖩";
                        title: "Hotspot";
                        subtitle: root.tile-hotspot ? "Penumbra-AP" : "Off";
                    }
                    ToggleTile {
                        width: (parent.width - 12px) / 2;
                        is-active <=> root.tile-rotate;
                        icon-text: "󰑮";
                        title: "Auto-rotate";
                        subtitle: root.tile-rotate ? "Portrait" : "Locked";
                    }
                }

                // Row 4
                HorizontalLayout {
                    spacing: 12px;
                    ToggleTile {
                        width: (parent.width - 12px) / 2;
                        is-active <=> root.tile-airplane;
                        icon-text: "✈";
                        title: "Airplane Mode";
                        subtitle: root.tile-airplane ? "On" : "Off";
                    }
                    ToggleTile {
                        width: (parent.width - 12px) / 2;
                        is-active <=> root.tile-battery-saver;
                        icon-text: "🔋";
                        title: "Battery Saver";
                        subtitle: root.tile-battery-saver ? "Eco mode" : "Off";
                    }
                }

                // Sliders: Brightness & Volume
                SliderPill {
                    value <=> root.brightness;
                    icon-text: "☀";
                    label: "Brightness";
                    changed(v) => { root.brightness-changed(v); }
                }

                SliderPill {
                    value <=> root.volume;
                    icon-text: "";
                    label: "Media Volume";
                    changed(v) => { root.volume-changed(v); }
                }
            }

            // Media Playback Widget (Visible in both compact and full)
            Rectangle {
                height: 72px;
                border-radius: Theme.radius-tile;
                background: Theme.surface-low;
                border-width: 1px;
                border-color: Theme.specular-rim;

                HorizontalLayout {
                    padding: 12px;
                    spacing: 12px;
                    alignment: space-between;

                    // Album Art
                    Rectangle {
                        width: 48px;
                        height: 48px;
                        border-radius: 12px;
                        background: #3B2E58;

                        Text {
                            text: "🎵";
                            font-size: 20px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }

                    // Track Info
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;

                        Text {
                            text: "Resonance";
                            font-size: 13px;
                            font-weight: 700;
                            color: Theme.on-surface;
                            overflow: elide;
                        }

                        Text {
                            text: "HOME • Odyssey";
                            font-size: 11px;
                            color: Theme.on-surface-variant;
                            overflow: elide;
                        }
                    }

                    // Play/Pause
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        y: (parent.height - self.height) / 2;
                        border-radius: Theme.radius-pill;
                        background: Theme.primary;

                        Text {
                            text: "⏸";
                            font-size: 15px;
                            color: Theme.on-primary;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                }
            }

            // Chronological Notification Preview Card (Full expansion)
            if root.expansion-progress > 0.35: Rectangle {
                height: 70px;
                border-radius: Theme.radius-tile;
                background: Theme.surface-low;
                border-width: 1px;
                border-color: Theme.specular-rim;

                HorizontalLayout {
                    padding: 12px;
                    spacing: 10px;
                    alignment: start;

                    Rectangle {
                        width: 34px;
                        height: 34px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 10px;
                        background: Theme.primary-container;

                        Text {
                            text: "★";
                            font-size: 16px;
                            color: Theme.primary;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }

                    VerticalLayout {
                        spacing: 2px;
                        alignment: center;

                        Text {
                            text: "Penumbra Core • Wayland Ready";
                            font-size: 12px;
                            font-weight: 700;
                            color: Theme.on-surface;
                        }

                        Text {
                            text: "Wayland convergence active: DSI phone shell ready";
                            font-size: 11px;
                            color: Theme.on-surface-variant;
                        }
                    }
                }
            }

            // Bottom Dismiss Pull Handle (Draggable)
            handle-container := Rectangle {
                height: 32px;
                background: transparent;

                Rectangle {
                    width: 52px;
                    height: 5px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    border-radius: 2.5px;
                    background: #FFFFFF66;
                }

                handle-touch := TouchArea {
                    property <length> press-start-y: 0px;
                    property <length> last-pos-y: 0px;

                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            self.press-start-y = handle-touch.mouse-y;
                            self.last-pos-y = handle-touch.mouse-y;
                        } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                            let total-dy = handle-touch.mouse-y - self.press-start-y;
                            let vel = (handle-touch.mouse-y - self.last-pos-y) / 1px / 0.016;
                            root.drag-released(root.slide-offset-y, vel);
                        }
                    }

                    moved => {
                        if (handle-touch.pressed) {
                            let delta = handle-touch.mouse-y - self.last-pos-y;
                            self.last-pos-y = handle-touch.mouse-y;
                            root.drag-delta(delta);
                        }
                    }
                }
            }
        }
    }
}
