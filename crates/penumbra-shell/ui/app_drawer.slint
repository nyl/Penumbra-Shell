import { Theme } from "theme.slint";
import { AppItem } from "app_item.slint";

export component DrawerAppTile inherits Rectangle {
    in property <AppItem> app;
    in property <length> base-x: 0px;
    in property <length> base-y: 0px;

    callback clicked();
    callback drag-started(string, AppItem, length, length); // id, app, screen_x, screen_y
    callback drag-moved(length, length);
    callback drag-ended(string, length, length);

    property <float> touch-x: 0.0;
    property <float> touch-y: 0.0;
    property <bool> is-down: false;
    property <bool> is-dragging: false;

    width: 80px;
    height: 96px;

    lp-timer := Timer {
        interval: 400ms;
        running: false;
        triggered => {
            self.running = false;
            if (root.is-down) {
                root.is-dragging = true;
                let sx = root.base-x + (root.touch-x * 1px);
                let sy = root.base-y + (root.touch-y * 1px);
                root.drag-started(root.app.id, root.app, sx, sy);
            }
        }
    }

    VerticalLayout {
        alignment: center;
        spacing: 6px;

        // Material 3 Expressive Squircle Container
        Rectangle {
            width: (root.is-down && !root.is-dragging) ? 52px : 56px;
            height: (root.is-down && !root.is-dragging) ? 52px : 56px;
            border-radius: 20px;
            background: (root.is-down && !root.is-dragging) ? #2e2a37 : #221f28;
            border-width: 0px;
            clip: true;
            x: (parent.width - self.width) / 2;

            animate width, height { duration: 110ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1.0); }
            animate background { duration: 110ms; easing: ease-out; }

            if root.app.has-icon: Image {
                source: root.app.icon;
                width: parent.width * 0.72;
                height: parent.height * 0.72;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            if !root.app.has-icon: Text {
                text: "📦";
                font-size: 24px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.app.name;
            color: #e6e0e9;
            font-size: 11.5px;
            font-weight: 500;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    tile-ta := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.touch-x = tile-ta.mouse-x / 1px;
                root.touch-y = tile-ta.mouse-y / 1px;
                root.is-down = true;
                root.is-dragging = false;
                lp-timer.running = true;
            } else if (event.kind == PointerEventKind.move) {
                if (root.is-dragging) {
                    let sx = root.base-x + tile-ta.mouse-x;
                    let sy = root.base-y + tile-ta.mouse-y;
                    root.drag-moved(sx, sy);
                } else if (root.is-down) {
                    let dx = Math.abs((tile-ta.mouse-x / 1px) - root.touch-x);
                    let dy = Math.abs((tile-ta.mouse-y / 1px) - root.touch-y);
                    if (dx > 12.0 || dy > 12.0) {
                        lp-timer.running = false;
                    }
                }
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                lp-timer.running = false;
                if (root.is-dragging) {
                    root.is-dragging = false;
                    root.is-down = false;
                    let sx = root.base-x + tile-ta.mouse-x;
                    let sy = root.base-y + tile-ta.mouse-y;
                    root.drag-ended(root.app.id, sx, sy);
                } else if (root.is-down) {
                    root.is-down = false;
                    let dx = Math.abs((tile-ta.mouse-x / 1px) - root.touch-x);
                    let dy = Math.abs((tile-ta.mouse-y / 1px) - root.touch-y);
                    if (dx < 12.0 && dy < 12.0) {
                        root.clicked();
                    }
                }
            }
        }
    }
}

export component AppDrawer inherits Rectangle {
    in property <[AppItem]> installed-apps: [];
    in property <bool> is-open: false;
    in property <float> drawer-progress: 1.0;
    in-out property <string> search-query: "";

    callback app-clicked(string);
    callback search-query-changed(string);
    callback search-accepted(string);
    callback start-drag(string, AppItem, length, length);
    callback drag-moved(length, length);
    callback drag-ended(string, length, length);
    callback close-requested();
    callback drawer-drag-delta(float);
    callback drawer-drag-released(float);

    changed search-query => {
        root.search-query-changed(self.search-query);
    }

    width: 100%;
    height: 100%;
    background: #131118;
    border-top-left-radius: 28px;
    border-top-right-radius: 28px;
    clip: true;

    VerticalLayout {
        padding-top: 8px;
        padding-bottom: 40px;
        padding-left: 20px;
        padding-right: 20px;
        spacing: 12px;
        alignment: start;

        // Top Material 3 Expressive Drag / Dismiss Handle (Touch enabled for smooth 1:1 pull down)
        Rectangle {
            height: 38px;
            background: transparent;

            Rectangle {
                width: 48px;
                height: 5px;
                border-radius: 2.5px;
                background: #79747e;
                x: (parent.width - self.width) / 2;
                y: 12px;
            }

            handle-touch := TouchArea {
                property <float> last-screen-y: 0.0;
                property <float> velocity: 0.0;
                property <float> total-drag: 0.0;
                property <bool> is-down: false;

                pointer-event(event) => {
                    // Absolute screen Y accounting for parent drawer sheet vertical position
                    let cur-screen-y = 42.0 + (1.0 - root.drawer-progress) * 873.0 + (handle-touch.mouse-y / 1px);
                    if (event.kind == PointerEventKind.down) {
                        self.last-screen-y = cur-screen-y;
                        self.velocity = 0.0;
                        self.total-drag = 0.0;
                        self.is-down = true;
                    } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                        if (self.is-down) {
                            self.is-down = false;
                            if (self.total-drag < 12.0) {
                                root.close-requested();
                            } else {
                                root.drawer-drag-released(self.velocity);
                            }
                        }
                    }
                }

                moved => {
                    if (self.is-down) {
                        let cur-screen-y = 42.0 + (1.0 - root.drawer-progress) * 873.0 + (handle-touch.mouse-y / 1px);
                        let delta = cur-screen-y - self.last-screen-y;
                        self.total-drag = self.total-drag + Math.abs(delta);
                        self.velocity = self.velocity * 0.6 + ((-delta / 873.0) / 0.016) * 0.4;
                        self.last-screen-y = cur-screen-y;
                        root.drawer-drag-delta(-delta / 873.0);
                    }
                }
            }
        }

        // Top Search Bar Pill (Material 3 Expressive - no G, live app filter)
        Rectangle {
            height: 52px;
            border-radius: 26px;
            background: #201d26;
            border-width: 1px;
            border-color: search-input.has-focus ? Theme.primary : #2e2a36;

            animate border-color { duration: 150ms; }

            HorizontalLayout {
                padding-left: 18px;
                padding-right: 14px;
                spacing: 12px;
                alignment: space-between;

                // Left: Search Icon + Text Input
                HorizontalLayout {
                    spacing: 12px;
                    alignment: center;
                    horizontal-stretch: 1;

                    Text {
                        text: "🔍";
                        font-size: 16px;
                        color: #a09cb0;
                        vertical-alignment: center;
                    }

                    // Input Container with overlay placeholder
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 40px;
                        clip: true;

                        if search-input.text == "": Text {
                            x: 0px;
                            y: 0px;
                            width: 100%;
                            height: 100%;
                            text: "Search apps...";
                            font-size: Theme.font-label;
                            color: #a09cb0;
                            vertical-alignment: center;
                        }

                        search-input := TextInput {
                            x: 0px;
                            y: 0px;
                            width: 100%;
                            height: 100%;
                            text <=> root.search-query;
                            font-size: Theme.font-label;
                            color: #e6e0e9;
                            vertical-alignment: center;
                            single-line: true;

                            edited => {
                                root.search-query-changed(self.text);
                            }
                            accepted => {
                                root.search-accepted(self.text);
                            }
                        }
                    }
                }

                // Right Action: Clear "✕" button when typing, or "🎙" microphone when empty
                if search-input.text != "": Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 14px;
                    background: #ffffff18;

                    Text {
                        text: "✕";
                        font-size: 13px;
                        font-weight: 700;
                        color: Theme.on-surface-variant;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => {
                            search-input.text = "";
                            root.search-query = "";
                            root.search-query-changed("");
                        }
                    }
                }

                if search-input.text == "": Text {
                    text: "🎙";
                    font-size: 16px;
                    color: Theme.primary;
                    vertical-alignment: center;
                }
            }
        }

        // Section: Real Installed Applications Grid (Dynamic FreeDesktop XDG Apps)
        if root.installed-apps.length == 0: Rectangle {
            height: 320px;

            VerticalLayout {
                alignment: center;
                spacing: 12px;

                Text {
                    text: "🔍";
                    font-size: 40px;
                    horizontal-alignment: center;
                }
                Text {
                    text: "No apps found";
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.on-surface;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.search-query != "" ? "No applications match \"" + root.search-query + "\"" : "No applications installed";
                    font-size: 12px;
                    color: Theme.on-surface-variant;
                    horizontal-alignment: center;
                }
            }
        }

        if root.installed-apps.length > 0: flick := Flickable {
            height: 640px;
            content-height: (root.installed-apps.length / 4 + 1) * 105px;

            VerticalLayout {
                spacing: 8px;
                alignment: start;

                for row in (root.installed-apps.length / 4 + 1): HorizontalLayout {
                    alignment: space-around;
                    for col in 4: Rectangle {
                        width: 80px;
                        height: 96px;
                        property <int> idx: row * 4 + col;
                        property <length> tile-base-x: 26.5px + col * 93px;
                        property <length> tile-base-y: 139px + flick.content-y + row * 104px;

                        if self.idx < root.installed-apps.length: DrawerAppTile {
                            app: root.installed-apps[parent.idx];
                            base-x: parent.tile-base-x;
                            base-y: parent.tile-base-y;
                            clicked => {
                                root.app-clicked(root.installed-apps[parent.idx].id);
                            }
                            drag-started(id, item, sx, sy) => {
                                root.start-drag(id, item, sx, sy);
                            }
                            drag-moved(sx, sy) => {
                                root.drag-moved(sx, sy);
                            }
                            drag-ended(id, sx, sy) => {
                                root.drag-ended(id, sx, sy);
                            }
                        }
                    }
                }
            }
        }
    }
}
