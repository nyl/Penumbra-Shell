import { Theme } from "theme.slint";
import { AppItem } from "app_item.slint";

export component DrawerAppTile inherits Rectangle {
    in property <AppItem> app;
    in property <length> base-x: 0px;
    in property <length> base-y: 0px;

    callback clicked();
    callback drag-started(string, AppItem, length, length); // id, app, screen_x, screen_y
    callback drag-moved(length, length);
    callback drag-ended(string, length, length);

    property <float> touch-x: 0.0;
    property <float> touch-y: 0.0;
    property <bool> is-down: false;
    property <bool> is-dragging: false;

    width: 80px;
    height: 96px;

    lp-timer := Timer {
        interval: 400ms;
        running: false;
        triggered => {
            self.running = false;
            if (root.is-down) {
                root.is-dragging = true;
                let sx = root.base-x + (root.touch-x * 1px);
                let sy = root.base-y + (root.touch-y * 1px);
                root.drag-started(root.app.id, root.app, sx, sy);
            }
        }
    }

    VerticalLayout {
        alignment: center;
        spacing: 6px;

        // Squircle Icon Container
        Rectangle {
            width: 56px;
            height: 56px;
            border-radius: 18px;
            background: #2b2832;
            border-width: 1px;
            border-color: #ffffff14;
            clip: true;
            x: (parent.width - self.width) / 2;

            if root.app.has-icon: Image {
                source: root.app.icon;
                width: 40px;
                height: 40px;
                x: 8px;
                y: 8px;
            }

            if !root.app.has-icon: Text {
                text: "📦";
                font-size: 24px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.app.name;
            color: #e6e0e9;
            font-size: 11px;
            font-weight: 500;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    tile-ta := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.touch-x = tile-ta.mouse-x / 1px;
                root.touch-y = tile-ta.mouse-y / 1px;
                root.is-down = true;
                root.is-dragging = false;
                lp-timer.running = true;
            } else if (event.kind == PointerEventKind.move) {
                if (root.is-dragging) {
                    let sx = root.base-x + tile-ta.mouse-x;
                    let sy = root.base-y + tile-ta.mouse-y;
                    root.drag-moved(sx, sy);
                } else if (root.is-down) {
                    let dx = Math.abs((tile-ta.mouse-x / 1px) - root.touch-x);
                    let dy = Math.abs((tile-ta.mouse-y / 1px) - root.touch-y);
                    if (dx > 12.0 || dy > 12.0) {
                        lp-timer.running = false;
                    }
                }
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                lp-timer.running = false;
                if (root.is-dragging) {
                    root.is-dragging = false;
                    root.is-down = false;
                    let sx = root.base-x + tile-ta.mouse-x;
                    let sy = root.base-y + tile-ta.mouse-y;
                    root.drag-ended(root.app.id, sx, sy);
                } else if (root.is-down) {
                    root.is-down = false;
                    let dx = Math.abs((tile-ta.mouse-x / 1px) - root.touch-x);
                    let dy = Math.abs((tile-ta.mouse-y / 1px) - root.touch-y);
                    if (dx < 12.0 && dy < 12.0) {
                        root.clicked();
                    }
                }
            }
        }
    }
}

export component AppDrawer inherits Rectangle {
    in property <[AppItem]> installed-apps: [];
    in property <bool> is-open: false;
    in-out property <string> search-query: "";

    callback app-clicked(string);
    callback search-query-changed(string);
    callback search-accepted(string);
    callback start-drag(string, AppItem, length, length);
    callback drag-moved(length, length);
    callback drag-ended(string, length, length);
    callback close-requested();

    width: 100%;
    height: 100%;
    background: #0E0C12F8;
    clip: true;

    // Swipe-down detector to dismiss App Drawer
    drawer-bg-ta := TouchArea {
        property <float> start-y: 0.0;
        property <bool> is-active: false;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                self.start-y = drawer-bg-ta.mouse-y / 1px;
                self.is-active = true;
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                if (self.is-active) {
                    self.is-active = false;
                    let dy = (drawer-bg-ta.mouse-y / 1px) - self.start-y;
                    if (dy > 30.0) {
                        search-input.text = "";
                        root.search-query = "";
                        root.search-query-changed("");
                        root.close-requested();
                    }
                }
            }
        }
    }

    VerticalLayout {
        padding-top: 52px;
        padding-bottom: 48px;
        padding-left: 20px;
        padding-right: 20px;
        spacing: 16px;
        alignment: start;

        // Top Dismiss Handle
        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 44px;
                height: 5px;
                border-radius: 2.5px;
                background: Theme.outline-variant;

                TouchArea {
                    clicked => {
                        search-input.text = "";
                        root.search-query = "";
                        root.search-query-changed("");
                        root.close-requested();
                    }
                }
            }
        }

        // Top Search Bar Pill
        Rectangle {
            height: 50px;
            border-radius: Theme.radius-pill;
            background: Theme.surface-high;
            border-width: 1px;
            border-color: search-input.has-focus ? Theme.primary : Theme.specular-rim;

            animate border-color { duration: 150ms; }

            HorizontalLayout {
                padding-left: 18px;
                padding-right: 14px;
                spacing: 10px;
                alignment: space-between;

                // Left: Search Icon + Text Input
                HorizontalLayout {
                    spacing: 10px;
                    alignment: center;
                    horizontal-stretch: 1;

                    Text {
                        text: "🔍";
                        font-size: 16px;
                        color: search-input.has-focus ? Theme.primary : Theme.on-surface-variant;
                        vertical-alignment: center;
                    }

                    // Input Container with overlay placeholder
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 40px;
                        clip: true;

                        if search-input.text == "": Text {
                            x: 0px;
                            y: 0px;
                            width: 100%;
                            height: 100%;
                            text: "Search apps...";
                            font-size: Theme.font-label;
                            color: Theme.on-surface-variant;
                            vertical-alignment: center;
                        }

                        search-input := TextInput {
                            x: 0px;
                            y: 0px;
                            width: 100%;
                            height: 100%;
                            text <=> root.search-query;
                            font-size: Theme.font-label;
                            color: Theme.on-surface;
                            vertical-alignment: center;
                            single-line: true;

                            edited => {
                                root.search-query-changed(self.text);
                            }
                            accepted => {
                                root.search-accepted(self.text);
                            }
                        }
                    }
                }

                // Right Action: Clear "✕" button when typing, or "🎙" microphone when empty
                if search-input.text != "": Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 14px;
                    background: #ffffff18;

                    Text {
                        text: "✕";
                        font-size: 13px;
                        font-weight: 700;
                        color: Theme.on-surface-variant;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => {
                            search-input.text = "";
                            root.search-query = "";
                            root.search-query-changed("");
                        }
                    }
                }

                if search-input.text == "": Text {
                    text: "🎙";
                    font-size: 16px;
                    color: Theme.primary;
                    vertical-alignment: center;
                }
            }
        }

        // Section: Real Installed Applications Grid (Dynamic FreeDesktop XDG Apps)
        if root.installed-apps.length == 0: Rectangle {
            height: 320px;

            VerticalLayout {
                alignment: center;
                spacing: 12px;

                Text {
                    text: "🔍";
                    font-size: 40px;
                    horizontal-alignment: center;
                }
                Text {
                    text: "No apps found";
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.on-surface;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.search-query != "" ? "No applications match \"" + root.search-query + "\"" : "No applications installed";
                    font-size: 12px;
                    color: Theme.on-surface-variant;
                    horizontal-alignment: center;
                }
            }
        }

        if root.installed-apps.length > 0: flick := Flickable {
            height: 640px;
            content-height: (root.installed-apps.length / 4 + 1) * 105px;

            VerticalLayout {
                spacing: 8px;
                alignment: start;

                for row in (root.installed-apps.length / 4 + 1): HorizontalLayout {
                    alignment: space-around;
                    for col in 4: Rectangle {
                        width: 80px;
                        height: 96px;
                        property <int> idx: row * 4 + col;
                        property <length> tile-base-x: 26.5px + col * 93px;
                        property <length> tile-base-y: 139px + flick.content-y + row * 104px;

                        if self.idx < root.installed-apps.length: DrawerAppTile {
                            app: root.installed-apps[parent.idx];
                            base-x: parent.tile-base-x;
                            base-y: parent.tile-base-y;
                            clicked => {
                                root.app-clicked(root.installed-apps[parent.idx].id);
                            }
                            drag-started(id, item, sx, sy) => {
                                root.start-drag(id, item, sx, sy);
                            }
                            drag-moved(sx, sy) => {
                                root.drag-moved(sx, sy);
                            }
                            drag-ended(id, sx, sy) => {
                                root.drag-ended(id, sx, sy);
                            }
                        }
                    }
                }
            }
        }
    }
}
