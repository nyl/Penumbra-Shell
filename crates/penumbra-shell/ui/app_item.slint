export struct AppItem {
    id: string,
    name: string,
    has-icon: bool,
    icon: image,
}

export struct TaskItem {
    id: int,
    app-id: string,
    name: string,
    has-icon: bool,
    icon: image,
}

export struct HomescreenItem {
    id: string,
    name: string,
    is-folder: bool,
    folder-id: string,
    page: int,
    x: int,
    y: int,
    has-icon: bool,
    icon: image,
    folder-count: int,
    has-prev-1: bool,
    preview-1: image,
    has-prev-2: bool,
    preview-2: image,
    has-prev-3: bool,
    preview-3: image,
    has-prev-4: bool,
    preview-4: image,
}
