import { NavBar } from "nav_bar.slint";

export component NavBarWindow inherits Window {
    title: "Penumbra Navigation Bar";
    width: 412px;
    height: 32px;
    background: transparent;
    default-font-family: "Droid Sans";

    in-out property <bool> solid: false;

    callback nav-home();
    callback nav-recents();
    callback nav-next-app();
    callback nav-prev-app();

    callback touch-down(float, float);
    callback touch-move(float, float);
    callback touch-up(float, float);

    nav-bar := NavBar {
        width: 100%;
        height: 100%;
        solid: root.solid;

        touch-down(x, y) => {
            root.touch-down(x, y);
        }

        touch-move(x, y) => {
            root.touch-move(x, y);
        }

        touch-up(x, y) => {
            root.touch-up(x, y);
        }

        gesture-triggered(kind) => {
            if (kind == "home") {
                root.nav-home();
            } else if (kind == "recents") {
                root.nav-recents();
            }
        }
    }
}
